	local function rebind(action, newKey)
		local old = Keybinds[action]
		-- If another action already uses this key, that action takes the old key (swap)
		for other, k in pairs(Keybinds) do
			if other ~= action and k == newKey then Keybinds[other] = old end
		end
		Keybinds[action] = newKey
		refreshKeybinds()
