local function ctl(name)
	local c = Cur.ctl
	if c and c[name] then c[name]() end
end

local function cleanupCharacter()
	if Cur.session then Cur.session.alive = false end
	for _, c in ipairs(charConns) do pcall(function() c:Disconnect() end) end
	table.clear(charConns)
	pcall(clearEmote)
	pcall(function() ContextActionService:UnbindAction("Dive") end)
	if AbilityVars.Trail then
		pcall(function() AbilityVars.Trail:Destroy() end)
		AbilityVars.Trail = nil
	end
	EmoteState.ca = nil
	Cur.ctl, Cur.hum, Cur.animator, Cur.char, Cur.root = nil, nil, nil, nil, nil
	Cur.variantEnd, Cur.idleStill = nil, nil
	Cur.diveHandler = nil
	Cur.anims = {}
	AbilityVars.char = nil
end

local function setupCharacter(newChar)
	cleanupCharacter()

	local session = { alive = true }
	Cur.session = session
	AbilityVars.Gen += 1
	resetAbilityFlags()

	local char = newChar
	local hum = char:WaitForChild("Humanoid")
	local rootpart = char:WaitForChild("HumanoidRootPart")
	local animator = hum:WaitForChild("Animator")
	local lowerTorso = char:WaitForChild("LowerTorso")
	if Cur.session ~= session then return end

	Cur.char, Cur.hum, Cur.root, Cur.animator = char, hum, rootpart, animator
	AbilityVars.char = char

	local A = {}
	Cur.anims = A

	hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
	hum.MaxSlopeAngle = Settings.MaxSlopeAngle

	-- Ability animations
	A.LongJump = loadAnim(animator, R15_Animations.Longjump)
	A.GroundPound = loadAnim(animator, R15_Animations.GroundPound)
