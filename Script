	-- Keep highlights attached to each member's current character, and update visibility
	local accum, profAccum = 0, 0
	gconn(RunService.Heartbeat:Connect(function(dt)
		accum += dt
		if accum < 0.1 then return end
		accum = 0
		local myRoot = Cur.root
		for i = 2, PARTY_SIZE do
			local slot = partySlots[i]
			if slot and slot.highlight then
				local char = slot.player.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if char and slot.highlight.Parent ~= char then slot.highlight.Parent = char end
				local dist = (myRoot and root) and (myRoot.Position - root.Position).Magnitude or 0
				slot.highlight.Enabled = root ~= nil and (highlightAlways or dist >= partyFar)
			end
		end
		if pf.Visible then
			profAccum += 0.1
			if profAccum >= 0.25 then
				profAccum = 0
				refreshProfile()
			end
		end
	end))

