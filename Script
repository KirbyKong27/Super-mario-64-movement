	A.TripleJump = loadAnim(animator, R15_Animations.TripleJump)
	A.DiveS = loadAnim(animator, R15_Animations.DiveS)
	A.Backflip = loadAnim(animator, R15_Animations.Backflip)

	-- Selected (mix & match) animations, preserved across respawns
	A.Crouch = loadAnim(animator, CrouchAnimations[SelectedAnimations.Crouch])
	A.Idle = loadAnim(animator, IdleAnimations[SelectedAnimations.Idle])
	local variantId = IdleVariants[SelectedAnimations.Idle]
	A.IdleVariant = variantId and loadAnim(animator, variantId) or nil
	if A.IdleVariant then A.IdleVariant.Looped = true end
	A.Walk = loadAnim(animator, RunAnimations[SelectedAnimations.Run])
	A.Fall = loadAnim(animator, FallAnimations[SelectedAnimations.Fall])
	A.Jump1 = loadAnim(animator, JumpAnimations[SelectedAnimations.Jump])
	A.Jump2 = loadAnim(animator, JumpAnimations[SelectedAnimations.Jump])
	A.WallJump = loadAnim(animator, WallSlideAnimations[SelectedAnimations.WallSlide])
	A.Dive = loadAnim(animator, DiveAnimations[SelectedAnimations.Dive])

	AbilityAnims.DiveAnim = A.Dive
	AbilityAnims.LongJumpAnim = A.LongJump
	AbilityAnims.DiveSAnim = A.DiveS
	AbilityAnims.WallJumpAnim = A.WallJump
	AbilityAnims.CrouchAnim = A.Crouch
	AbilityAnims.GroundPoundAnim = A.GroundPound
	AbilityAnims.GroundPoundStartA = A.GroundPoundS
	AbilityAnims.RollAnim = A.TripleJump

	-- Trail
	local att0 = ins("Attachment")
	att0.Name = "Trail0"
	att0.CFrame = CFrame.new(0, 0, 0)
	att0.Parent = lowerTorso
	local att1 = ins("Attachment")
	att1.Name = "Trail1"
	att1.CFrame = CFrame.new(0, rootpart.Size.Y / 2, 0)
	att1.Parent = lowerTorso
	local trail = ins("Trail")
	trail.Name = "AirTrail"
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	trail.FaceCamera = false
	trail.TextureMode = Enum.TextureMode.Stretch
	trail.MinLength = 0
	trail.Lifetime = 0.2
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0)
	trail.Parent = char
	AbilityVars.Trail = trail

	-- Kill default Animate script (and any re-added copy)
	local animate = char:FindFirstChild("Animate")
	if animate then animate:Destroy() end
	track(char.ChildAdded:Connect(function(c)
		if c.Name == "Animate" then task.defer(c.Destroy, c) end
	end))
	for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop() end

	-- Anti-fling
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
			pcall(function() PhysicsService:SetPartCollisionGroup(v, "NoFling") end)
		end
	end

	local hitGP = ins("BoolValue", char)
	hitGP.Name = "HitfloorGP"
	hitGP.Value = false
	local GFX = ins("Model", char)
	GFX.Name = "GFX"

	local running = rootpart:FindFirstChild("Running")
	if not running then
		running = ins("Sound", rootpart)
		running.Name = "Running"
		running.SoundId = "rbxasset://sounds/Swoosh.mp3"
		running.Volume = 0
		running.TimePosition = 0
	end
	local jumpingSound = rootpart:FindFirstChild("Jumping")
	if jumpingSound then jumpingSound.Pitch = 0 end

	-- Movement state (per character)
	local pose, grounded, OnSlope, speed = "None", true, false, 0
	local stage, JumpStage = 0, 0
	local triplejumping, doublejump, jumping = false, false, false
	local WallJumping, Scootering = false, false
	local FadeAmount, FadeAmount2 = 0.3, 0.15
	local JumpCooldown = Settings.WallJumpCooldown
	local GrabCooldown = Settings.WallJumpCooldown
	local WallGripLeft, JumpWait, GrabWait = 0, 0, 0
	local GripLookVector = Vector3.new(0, 0, -1)
	local jump = false
	local falling = false

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
	raycastParams.FilterDescendantsInstances = {char, GFX, workspace.CurrentCamera}
	raycastParams.IgnoreWater = true
	raycastParams.RespectCanCollide = true

	track(hum.Running:Connect(function(s) speed = s end))

	-- Ground/slope/state detection + emote-facing
	track(RunService.RenderStepped:Connect(function(dt)
		if Cur.session ~= session then return end

		-- Head camera (from Forsaken): offsets the camera to the head based on mode
		local headCamOn
		if HeadCam.mode == 1 then headCamOn = AbilityVars.Emoting
		elseif HeadCam.mode == 2 then headCamOn = not AbilityVars.Emoting
		elseif HeadCam.mode == 3 then headCamOn = true
		else headCamOn = false end
		local head = char:FindFirstChild("Head")
		local alpha = math.min(dt * 5, 1)
		if headCamOn and head then
			local goal = (rootpart.CFrame + Vector3.new(0, 1.5, 0)):PointToObjectSpace(head.Position)
			hum.CameraOffset = hum.CameraOffset:Lerp(goal, alpha)
		else
			hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.zero, alpha)
		end

		-- While emoting (non-moving emotes), holding a direction turns the character to face it
		if AbilityVars.Emoting and not AbilityVars.MovingEmote then
			local md = hum.MoveDirection
			local flat = Vector3.new(md.X, 0, md.Z)
			if flat.Magnitude > 0.01 then
				rootpart.CFrame = rootpart.CFrame:Lerp(CFrame.lookAt(rootpart.Position, rootpart.Position + flat), 0.1)
			end
		end

		local ray = workspace:Raycast(rootpart.Position, Vector3.new(0, -3000, 0), raycastParams)
		local rootvel = math.floor(rootpart.Velocity.Y)
		local moving = hum.MoveDirection ~= Vector3.zero

		if ray then
			local dis = (rootpart.Position - ray.Position).Magnitude
			if dis > 3.8 and rootpart.Velocity.Y > 1 then pose = "Jumping"; grounded = false end
			if dis > 3.8 and rootpart.Velocity.Y < -1 then pose = "Falling"; grounded = false end
			if dis < 4 and AbilityVars.GroundPounding then AbilityVars.hitfloor = true end
			if dis < 3.8 then
				pose = moving and "Walking" or "Standing"
				grounded = true
			end
		else
			if rootpart.Velocity.Y > 0 and not grounded then pose = "Jumping"; grounded = false end
			if rootpart.Velocity.Y < 0 and not grounded then pose = "Falling"; grounded = false end
			if not moving and grounded then pose = "Standing"; grounded = true end
			if moving and grounded then pose = "Walking"; grounded = true end
		end

		local st = States:GetState()
		-- Emoting is excluded so the slope code can't un-freeze a stationary emote
		local canSlope = not AbilityVars.Diving and grounded and st == "Default" and not AbilityVars.Crouching and not AbilityVars.Emoting
		if rootvel > 5 and canSlope then
			hum.WalkSpeed = math.clamp(hum.WalkSpeed - Settings.SlopeSpeedLossRate, Settings.MinSlopeSpeed, Settings.MaxSlopeSpeed)
			OnSlope = true
			if AbilityVars.DiveSliding then
				AbilityVars.DiveSpeed = math.clamp(AbilityVars.DiveSpeed - Settings.SlopeDiveSlideLossRate, 0, 50)
			end
		elseif rootvel < -4 and canSlope then
			hum.WalkSpeed = math.clamp(hum.WalkSpeed + Settings.SlopeSpeedGainRate, 0, Settings.MaxSlopeSpeed)
			OnSlope = true
			if AbilityVars.DiveSliding then
				AbilityVars.DiveSpeed = math.clamp(AbilityVars.DiveSpeed + Settings.SlopeDiveSlideGainRate, 0, 50)
			end
		elseif rootvel <= 0 and rootvel >= -4 and pose == "Walking" and grounded then
			OnSlope = false
		end
	end))

	-- Dust loop
	task.spawn(function()
		while session.alive do
			task.wait()
			if AbilityVars.DiveSliding then
				Effects.Dust()
				task.wait(0.02)
			end
			if WallJumping then
				Effects.WalljumpDust()
				task.wait(0.02)
			end
		end
	end)

	-- Jump progression
	local function onJump(val)
		if AbilityVars.Emoting then return end
		jumping = val
		if jumping then AbilityVars.backflipping = false end

		if jumping and JumpStage == 2 then
			if hum.MoveDirection == Vector3.zero then
				AbilityVars.LongJumping = false
				JumpStage = 0
				doublejump = false
				OnSlope = false
				A.DoubleJump:Stop()
				Sounds.PlaySound(char, JUMP_SOUND, 3, 1)
				if math.random(1, 2) == 1 then A.Jump1:Play(FadeAmount2) else A.Jump2:Play(FadeAmount2) end
				return
			end
			if AbilityVars.Trail then AbilityVars.Trail.Enabled = true end
			grounded = false
			OnSlope = false
			JumpStage = 3
			triplejumping = true
			A.TripleJump:Play(FadeAmount2)
			Sounds.PlaySound(char, JUMP_SOUND, 3, 2)
			rootpart.Velocity = Vector3.new(0, Settings.TripleJumpHeight + hum.WalkSpeed / Settings.JumpWalkSpeedBonusDivisor, 0)

		elseif jumping and JumpStage == 1 then
			if hum.MoveDirection == Vector3.zero then
				AbilityVars.LongJumping = false
				OnSlope = false
				grounded = false
				JumpStage = 0
				doublejump = false
				A.DoubleJump:Stop()
				Sounds.PlaySound(char, JUMP_SOUND, 3, 1)
				if math.random(1, 2) == 1 then A.Jump1:Play(FadeAmount2) else A.Jump2:Play(FadeAmount2) end
				return
			end
			JumpStage = 2
			Sounds.PlaySound(char, JUMP_SOUND, 3, 1.5)
			rootpart.Velocity = Vector3.new(0, Settings.DoubleJumpHeight + hum.WalkSpeed / Settings.JumpWalkSpeedBonusDivisor, 0)
			doublejump = true
			A.DoubleJump:Play(FadeAmount2)

		elseif jumping and JumpStage == 0 then
			grounded = false
			OnSlope = false
			JumpStage = 1
			doublejump = false
			triplejumping = false
			rootpart.Velocity = Vector3.new(0, Settings.RegularJumpHeight + hum.WalkSpeed / Settings.JumpWalkSpeedBonusDivisor, 0)
			Sounds.PlaySound(char, JUMP_SOUND, 3, 1)
		end
	end
	track(hum.Jumping:Connect(onJump))

	track(hum.FreeFalling:Connect(function(val)
		falling = val
		if val == false then
			task.wait(0.15)
			if JumpStage > 0 and falling == false then
				JumpStage = 0
				triplejumping = false
				doublejump = false
			end
		end
	end))

	-- Crouch / ground pound helpers
	local function crouch()
		pcall(function()
			if AbilityVars.Emoting then return end
			if not AbilityVars.GroundPounding and not AbilityVars.LongJumping and not AbilityVars.Diving and not WallJumping and not doublejump and pose ~= "Jumping" and pose ~= "Freefall" and grounded then
				AbilityVars.Crouching = true
				OnSlope = true
				AbilityVars.backflipping = false
				hum.WalkSpeed = Settings.CrouchWalkSpeed
				hum.JumpPower = 0
				AbilityVars.cananimate = false
				for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop() end
				A.Crouch:Play()
				-- Frozen (speed 0) while standing still, animating while moving
				A.Crouch:AdjustSpeed(hum.MoveDirection.Magnitude > 0.05 and 1 or 0)
			end
			if not grounded and not AbilityVars.Diving then
				GroundPound_Ability()
				AbilityVars.Crouching = false
			end
		end)
	end

	local function uncrouch()
		pcall(function()
			if not AbilityVars.LongJumping and not AbilityVars.Diving and not AbilityVars.DiveSliding and pose ~= "Jumping" and pose ~= "Freefall" and grounded then
				AbilityVars.Crouching = false
				OnSlope = false
				AbilityVars.cananimate = true
				hum.JumpPower = Settings.BaseJumpPower
				A.Crouch:Stop()
			end
		end)
	end

	Cur.ctl = { crouch = crouch, uncrouch = uncrouch }

	local function routeJump()
		if AbilityVars.Emoting then return end
		if AbilityVars.DiveSliding then
			CancelSlide_Ability()
		elseif AbilityVars.Crouching and hum.MoveDirection ~= Vector3.zero then
			LongJump_Ability()
		elseif AbilityVars.Crouching and hum.MoveDirection == Vector3.zero then
			Backflip_Ability()
		end
	end

	-- Input (PC only; mobile buttons are built once globally and call Cur.ctl)
	if not isMobile then
		track(UserInputService.JumpRequest:Connect(function()
			if hum.FloorMaterial == Enum.Material.Air then
				jump = true
				hum.JumpPower = 0
			end
		end))
		track(UserInputService.InputBegan:Connect(function(io)
			if io.KeyCode == Enum.KeyCode.Space or io.KeyCode == Enum.KeyCode.ButtonA then
				if not jump then
					hum.JumpPower = Settings.BaseJumpPower
					hum.Jump = true
				end
			elseif io.KeyCode == Keybinds.Crouch or io.KeyCode == Enum.KeyCode.ButtonR2 then
				crouch()
			end
		end))
		track(UserInputService.InputEnded:Connect(function(io)
			if io.KeyCode == Enum.KeyCode.Space or io.KeyCode == Enum.KeyCode.ButtonA then
				jump = false
			elseif io.KeyCode == Keybinds.Crouch or io.KeyCode == Enum.KeyCode.ButtonR2 then
				uncrouch()
			end
		end))
	end

	-- Space/ability input routing (Roblox JumpRequest fires for Space and touch jump)
	track(UserInputService.JumpRequest:Connect(routeJump))

	Cur.diveHandler = function(_, state)
		if AbilityVars.Emoting then return end
		if state == Enum.UserInputState.Begin and not AbilityVars.GroundPounding and not WallJumping then
			Dive_Ability()
		end
	end
	bindDiveKey()

	-- Wall jump
	local function clearWall()
		WallJumping = false
		WallGripLeft = 0
		OnSlope = false
		hum.AutoRotate = true
		GrabWait = GrabCooldown
		A.WallJump:Stop()
		AbilityVars.cananimate = true
		local bv = rootpart:FindFirstChild("BodyVelocity")
		if bv then bv:Destroy() end
	end
	local function loseGrip()
		clearWall()
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end
	local function land() clearWall() end

	track(RunService.Heartbeat:Connect(function()
		if AbilityVars.Emoting or Cur.session ~= session then return end
		if hum:GetState() ~= Enum.HumanoidStateType.Freefall or Scootering then return end

		local ray = Ray.new(rootpart.Position, rootpart.CFrame.LookVector * 1.5)
		local ray2 = Ray.new(rootpart.Position, rootpart.CFrame.LookVector * -1.5)
		local hit, _, normal = workspace:FindPartOnRay(ray, char)
		local hit2 = workspace:FindPartOnRay(ray2, char)

		if hit then
			if not hit:FindFirstChild("_Wall") and hit.CanCollide and hit.Transparency ~= 1 and not WallJumping then
				WallJumping = true
				JumpStage = 0
				local normalCFrame = hit.CFrame:ToObjectSpace(CFrame.new(Vector3.zero, normal))
				normalCFrame = normalCFrame - normalCFrame.Position
				local offsetCFrame = CFrame.new((hit.CFrame:Inverse() * rootpart.CFrame).Position)
				local newCFrame = hit.CFrame * offsetCFrame * normalCFrame

				for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:Stop() end

				AbilityVars.cananimate = false
				A.WallJump:Play()
				OnSlope = true
				hum.AutoRotate = false
				Sounds.PlaySound(char, LAND_SOUND, 3, 1)

				local bv = ins("BodyVelocity", rootpart)
				bv.Velocity = Vector3.new(0, -10, 0)
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				rootpart.CFrame = newCFrame
				GripLookVector = newCFrame.LookVector
				WallGripLeft = Settings.WallGripDuration
				JumpWait = JumpCooldown
			end
		elseif not hit2 and WallJumping then
			loseGrip()
		end
	end))

	track(hum:GetPropertyChangedSignal("Jump"):Connect(function()
		if AbilityVars.Emoting then return end
		if WallJumping and hum.Jump and JumpWait >= 0 then
			loseGrip()
			Sounds.PlaySound(char, JUMP_SOUND, 3, 1)
			triplejumping = false
			doublejump = false
			rootpart.Velocity = Vector3.new(0, Settings.WallJumpUpForce, 0) + GripLookVector * Settings.WallJumpPushForce
		end
	end))

	-- State changes (landings, dive slide, long jump landing, ground pound hit)
	track(hum.StateChanged:Connect(function(old, new)
		pcall(function()
			local landing = rootpart:FindFirstChild("Landing")
			local runSound = rootpart:FindFirstChild("Running")
			local function landSound()
				if landing then Sounds.PlaySound(char, landing.SoundId, 3, 1) end
			end
			local function setRunVol(v)
				if runSound then runSound.Volume = v end
			end
			local isRunning = new == Enum.HumanoidStateType.Running or new == Enum.HumanoidStateType.RunningNoPhysics

			if AbilityVars.Diving and old == Enum.HumanoidStateType.Flying then
				AbilityVars.Diving = false
				AbilityVars.canDive = true
				landSound()
				hum.JumpPower = 0
				setRunVol(1)
				DiveSlide_Ability()

			elseif new == Enum.HumanoidStateType.Landed and old == Enum.HumanoidStateType.Freefall then
				triplejumping = false
				A.TripleJump:Stop()
				if AbilityVars.Trail then AbilityVars.Trail.Enabled = false end
				jump = false
				grounded = true
				land()
				Effects.LandEffect(char, 1.7, 8)
				landSound()

			elseif AbilityVars.LongJumping and old == Enum.HumanoidStateType.Flying then
				if isRunning then
					AbilityVars.LongJumping = false
					AbilityVars.cananimate = true
					OnSlope = false
					if AbilityVars.Trail then AbilityVars.Trail.Enabled = false end
					hum.WalkSpeed = Settings.LongJumpLandWalkSpeed
					landSound()
					Effects.LandEffect(char, 1.7, 8)
					setRunVol(1)
				end

			elseif old == Enum.HumanoidStateType.Flying then
				if isRunning then
					landSound()
					Effects.LandEffect(char, 1.7, 8)
					A.TripleJump:Stop()
					triplejumping = false
					AbilityVars.cananimate = true
					setRunVol(1)
				end
			end

			if isRunning then
				grounded = true
			elseif new == Enum.HumanoidStateType.Freefall or new == Enum.HumanoidStateType.Jumping then
				grounded = false
			end

			if AbilityVars.backflipping and old == Enum.HumanoidStateType.Flying and isRunning then
				AbilityVars.backflipping = false
				landSound()
				Effects.LandEffect(char, 1.7, 8)
			end

			if AbilityVars.GroundPounding and old == Enum.HumanoidStateType.Freefall then
				AbilityVars.hitfloor = true
				AbilityVars.backflipping = false
				JumpStage = 1
				task.wait(0.35)
				JumpStage = 0
			end
		end)
	end))

	-- Animation controller
	task.spawn(function()
		while session.alive do
			task.wait()
			if AbilityVars.Emoting then continue end

			-- Idle variant timer resets whenever the character stops standing still
			if pose ~= "Standing" or not AbilityVars.cananimate then
				if Cur.variantEnd or Cur.idleStill then stopIdleVariant() end
			end

			local tracks = hum:GetPlayingAnimationTracks()
			local moving = hum.MoveDirection.Magnitude > 0.05
			A.Walk:AdjustSpeed(math.clamp(hum.WalkSpeed / 15, 0, 2))

			-- Crouch freeze: stopped = frozen, moving = animating
			if AbilityVars.Crouching and A.Crouch.IsPlaying then
				A.Crouch:AdjustSpeed(moving and 1 or 0)
			end

			if pose == "Walking" and AbilityVars.cananimate then
				if hum.WalkSpeed < 36 then
					stage = 1
					if not OnSlope and hum.WalkSpeed < Settings.MinSlopeSpeed and States:GetState() == "Default" then
						hum.WalkSpeed = hum.WalkSpeed + Settings.WalkAccelRate
					end
					if hum.WalkSpeed > Settings.MinSlopeSpeed then
						hum.WalkSpeed = hum.WalkSpeed - Settings.WalkDecelRate
					end
					for _, t in ipairs(tracks) do
						if t ~= A.Walk and t ~= A.TripleJump then t:Stop() end
					end
					if stage ~= 2 and stage ~= 3 and not A.Walk.IsPlaying then A.Walk:Play() end
				end

			elseif pose == "Standing" and AbilityVars.cananimate then
				if States:GetState() == "Default" then hum.WalkSpeed = Settings.BaseWalkSpeed end
				local now = os.clock()

				if Cur.variantEnd then
					-- Variant is playing: end it after its duration or when the player moves
					if now >= Cur.variantEnd or moving then
						stopIdleVariant()
						Cur.idleStill = now -- restart the wait before the next variant
					else
						for _, t in ipairs(tracks) do
							if t ~= A.IdleVariant then t:Stop() end
						end
					end
				end

				if not Cur.variantEnd then
					Cur.idleStill = Cur.idleStill or now
					for _, t in ipairs(tracks) do
						if t ~= A.Idle then t:Stop() end
					end
					if A.IdleVariant and now - Cur.idleStill >= IDLE_VARIANT_DELAY then
						Cur.variantEnd = now + math.random(90, 100) / 10
						A.Idle:Stop(0.25)
						A.IdleVariant:Play(0.25)
					elseif not A.Idle.IsPlaying then
						A.Idle:Play()
					end
				end

			elseif pose == "Jumping" and AbilityVars.cananimate then
				for _, t in ipairs(tracks) do
					if t ~= A.Jump1 and t ~= A.Jump2 and t ~= A.DoubleJump and t ~= A.TripleJump and t ~= A.Backflip then
						t:Stop(FadeAmount2)
					end
				end
				local anyJumpPlaying = A.Jump1.IsPlaying or A.Jump2.IsPlaying or A.DoubleJump.IsPlaying or A.TripleJump.IsPlaying or A.Backflip.IsPlaying
				if not anyJumpPlaying then
					local bf = AbilityVars.backflipping
					if not doublejump and not triplejumping and not bf then
						A.TripleJump:Stop()
						A.DoubleJump:Stop()
						A.Backflip:Stop()
						if math.random(1, 2) == 1 then A.Jump1:Play(FadeAmount2) else A.Jump2:Play(FadeAmount2) end
					elseif doublejump and not triplejumping and not bf then
						A.DoubleJump:Play(FadeAmount2)
					elseif triplejumping and not doublejump and not bf then
						A.TripleJump:Play(FadeAmount2)
					elseif bf and not doublejump and not triplejumping then
						A.Backflip:Play()
					end
				end

			elseif pose == "Falling" and AbilityVars.cananimate then
				for _, t in ipairs(tracks) do
					if t ~= A.Fall and t ~= A.TripleJump then t:Stop(FadeAmount) end
				end
				if not A.Fall.IsPlaying and not A.TripleJump.IsPlaying then A.Fall:Play(FadeAmount) end
			end
		end
	end)

	-- Clear emote when the character dies (the new character gets a fresh setup)
	track(hum.Died:Connect(function() pcall(clearEmote) end))

	hum.WalkSpeed = Settings.BaseWalkSpeed
end

