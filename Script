local function shutdown()
	pcall(function()
		local h = Cur.hum
		if h then
			for _, t in ipairs(h:GetPlayingAnimationTracks()) do t:Stop(0) end
			h.WalkSpeed = 16
			h.JumpPower = 50
		end
	end)
	for _, h in ipairs(ShutdownHooks) do pcall(h) end
	cleanupCharacter()
	for _, c in ipairs(globalConns) do pcall(function() c:Disconnect() end) end
	table.clear(globalConns)
	if sg then sg:Destroy() end
	if mobileGui then mobileGui:Destroy() end
	getgenv().ParkourShutdown = nil
end
getgenv().ParkourShutdown = shutdown

