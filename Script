local function loadAnim(animator, id)
	local anim = ins("Animation")
	anim.AnimationId = id
	return animator:LoadAnimation(anim)
end

-- Ends an idle variant early (or when it finishes) and resets its timer
local function stopIdleVariant()
	Cur.variantEnd = nil
	Cur.idleStill = nil
	local v = Cur.anims and Cur.anims.IdleVariant
	if v then pcall(function() v:Stop(0.25) end) end
end

local function reloadSelected(kind)
	local h, A = Cur.animator, Cur.anims
	if not h or not A.Idle then return end
	local function rep(key, id)
		if not id then return end
		local was = A[key] and A[key].IsPlaying
		if A[key] then pcall(function() A[key]:Stop(0) end) end
		A[key] = loadAnim(h, id)
		if was then A[key]:Play() end
	end

	if kind == "Idle" then
		stopIdleVariant()
		rep("Idle", IdleAnimations[SelectedAnimations.Idle])
		if A.IdleVariant then pcall(function() A.IdleVariant:Stop(0) end) end
		local vid = IdleVariants[SelectedAnimations.Idle]
		A.IdleVariant = vid and loadAnim(h, vid) or nil
		if A.IdleVariant then A.IdleVariant.Looped = true end
	elseif kind == "Run" then
		rep("Walk", RunAnimations[SelectedAnimations.Run])
	elseif kind == "Jump" then
		local id = JumpAnimations[SelectedAnimations.Jump]
		rep("Jump1", id)
		rep("Jump2", id)
	elseif kind == "Fall" then
		rep("Fall", FallAnimations[SelectedAnimations.Fall])
	elseif kind == "Crouch" then
		rep("Crouch", CrouchAnimations[SelectedAnimations.Crouch])
		AbilityAnims.CrouchAnim = A.Crouch
	elseif kind == "WallSlide" then
		rep("WallJump", WallSlideAnimations[SelectedAnimations.WallSlide])
		AbilityAnims.WallJumpAnim = A.WallJump
	elseif kind == "Dive" then
		rep("Dive", DiveAnimations[SelectedAnimations.Dive])
		AbilityAnims.DiveAnim = A.Dive
	end
end

local function applyAnim(kind, name)
	local lib = AnimLibs[kind]
	if not lib or not lib[name] then return end
	SelectedAnimations[kind] = name
	reloadSelected(kind)
end

