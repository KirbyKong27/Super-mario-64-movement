	-- Highlights are outline-only (FillTransparency 1) and parented to the member's character
	local function makeHighlight(slot)
		if slot.highlight then slot.highlight:Destroy() end
		local hl = ins("Highlight")
		hl.Name = "PartyHighlight"
		hl.FillTransparency = 1
		hl.OutlineTransparency = 0
		hl.OutlineColor = slot.color
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Enabled = false
		slot.highlight = hl
	end

	local function clearSlot(i)
		if i == 1 then return end
		local slot = partySlots[i]
		if slot and slot.highlight then slot.highlight:Destroy() end
		partySlots[i] = nil
	end

	local function assignSlot(i, p)
		clearSlot(i)
		local slot = {player = p, color = PARTY_COLORS[i]}
		partySlots[i] = slot
		makeHighlight(slot)
		partySelected = i
	end

	local function refreshParty()
		for i = 1, PARTY_SIZE do
			local t = partyTabs[i]
			local slot = partySlots[i]
			if slot then
				t.avatar.Visible = true
				t.avatar.Image = getThumb(slot.player.UserId)
				t.name.Text = slot.player.DisplayName
				t.plus.Visible = false
				t.stroke.Color = slot.color
			else
				t.avatar.Visible = false
				t.name.Text = ""
				t.plus.Visible = true
				t.stroke.Color = c3(70, 70, 70)
			end
			t.stroke.Thickness = (i == partySelected) and 3 or 1
		end
	end

	local function refreshProfile()
		local slot = partySlots[partySelected]
		if not slot then
			partySelected = 1
			slot = partySlots[1]
		end
		local p = slot.player
		bigAv.Image = getThumb(p.UserId)
		profName.Text = p.DisplayName .. "  (@" .. p.Name .. ")"
		local st, anims = describeState(p)
		profState.Text = st
		profAnim.Text = anims ~= "" and anims or "No animations playing"
		swatchRow.Visible = not slot.isSelf
		removeBtn.Visible = not slot.isSelf
	end

	local function openPicker(i)
		pickerTarget = i
		for _, c in ipairs(pickList:GetChildren()) do
			if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
		end
		local count = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= plr and not inParty(p) then
				count += 1
				local b = ins("TextButton")
				b.Size = ud2(1, -6, 0, 30)
				b.BackgroundColor3 = c3(40, 40, 40)
				b.Text = p.DisplayName .. "  (@" .. p.Name .. ")"
				b.TextColor3 = c3(255, 255, 255)
				b.Font = Enum.Font.Gotham
				b.TextSize = 13
				b.Parent = pickList
				corner(b, 4)
				b.MouseButton1Click:Connect(function()
					assignSlot(pickerTarget, p)
					picker.Visible = false
					refreshParty()
					refreshProfile()
				end)
			end
		end
		if count == 0 then
			local e = ins("TextLabel")
			e.Size = ud2(1, -6, 0, 30)
			e.BackgroundTransparency = 1
			e.Text = "No other players in this server"
			e.TextColor3 = c3(150, 150, 150)
			e.Font = Enum.Font.Gotham
			e.TextSize = 12
			e.Parent = pickList
		end
		picker.Visible = true
	end

