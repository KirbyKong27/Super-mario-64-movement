local lastDiveTime = 0
local function Dive_Ability()
	pcall(function()
		if AbilityVars.Emoting or AbilityVars.Diving then return end
		if tick() - lastDiveTime < 0.1 then return end
		lastDiveTime = tick()
		local char = AbilityVars.char
		local humanoid = char and char:FindFirstChild("Humanoid")
		local rootpart = char and char:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootpart then return end

		AbilityVars.LongJumping = false
		AbilityVars.canDive = false
		AbilityVars.Diving = true

		local running = rootpart:FindFirstChild("Running")
		if running then running.Volume = 0 end
		if AbilityVars.Trail then AbilityVars.Trail.Enabled = true end

		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end

		AbilityVars.cananimate = false
		AbilityVars.diveCount += 1
		AbilityVars.totalDives += 1
		AbilityAnims:PlayAnimation("Dive")

		humanoid:ChangeState(Enum.HumanoidStateType.Flying)
		rootpart.Velocity = rootpart.CFrame.LookVector * humanoid.WalkSpeed * Settings.DiveForwardMultiplier + Vector3.new(0, Settings.DiveUpwardBoost, 0)
		AbilityVars.DiveSpeed = rootpart.Velocity.Y
		rootpart.RotVelocity = rootpart.CFrame:VectorToWorldSpace(Vector3.new(-math.rad(100), 0, 0))

		Sounds.PlaySound(char, JUMP_SOUND, 3, 1.5)

		local currentDive = AbilityVars.totalDives
		task.wait(0.5)
		if currentDive == AbilityVars.totalDives then rootpart.RotVelocity = Vector3.zero end
	end)
end

local function DiveSlide_Ability()
	pcall(function()
		local char = AbilityVars.char
		local humanoid = char and char:FindFirstChild("Humanoid")
		local rootpart = char and char:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootpart then return end
		local gen = AbilityVars.Gen

		AbilityVars.DiveSpeed = AbilityVars.DiveSpeed - Settings.DiveSlideStartPenalty
		AbilityVars.canDive = false

		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end

		if AbilityVars.Trail then AbilityVars.Trail.Enabled = false end
		AbilityAnims:PlayAnimation("DiveSlide")
		AbilityVars.cananimate = false

		local vel = ins("BodyVelocity")
		vel.MaxForce = Vector3.new(math.huge, 0, math.huge)
		vel.Velocity = Vector3.new(0, Settings.DiveSlideDownforce, 0)
		vel.Parent = rootpart

		humanoid.MaxSlopeAngle = 1

		local running = rootpart:FindFirstChild("Running")
		if running then running.Volume = 0 end

		AbilityVars.DiveSliding = true

		while AbilityVars.DiveSpeed > 0 and AbilityVars.Gen == gen do
			task.wait()
			vel.Velocity = rootpart.CFrame.LookVector * AbilityVars.DiveSpeed
			AbilityVars.DiveSpeed = AbilityVars.DiveSpeed - Settings.DiveSlideDeceleration
			humanoid.JumpPower = 0
		end

		AbilityVars.canDive = true
		AbilityVars.DiveSliding = false
		AbilityAnims:StopAnimation("DiveSlide")
		if running then running.Volume = 1 end
		AbilityVars.cananimate = true
		vel:Destroy()

		humanoid.JumpPower = Settings.BaseJumpPower
		humanoid.MaxSlopeAngle = Settings.MaxSlopeAngle
	end)
end

local function CancelSlide_Ability()
	pcall(function()
		if AbilityVars.Emoting then return end
		local char = AbilityVars.char
		local humanoid = char and char:FindFirstChild("Humanoid")
		local rootpart = char and char:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootpart then return end

		AbilityVars.cananimate = false
		AbilityVars.DiveSlideCanceling = true
		humanoid:ChangeState(Enum.HumanoidStateType.Flying)
		rootpart.RotVelocity = Vector3.zero
		rootpart.Velocity = rootpart.CFrame:VectorToWorldSpace(Vector3.new(0, Settings.SlideCancelUpForce, -humanoid.WalkSpeed * Settings.SlideCancelBackMultiplier))

		Sounds.PlaySound(char, JUMP_SOUND, 3, 2.5)
		AbilityAnims:PlayAnimation("Roll")

		local running = rootpart:FindFirstChild("Running")
		if running then running.Volume = 0 end

		AbilityVars.DiveSpeed = 0
		AbilityVars.DiveSliding = false
		if AbilityVars.Trail then AbilityVars.Trail.Enabled = false end

		for _, v in ipairs(rootpart:GetChildren()) do
			if v:IsA("BodyVelocity") then v:Destroy() end
		end

		AbilityAnims:StopAnimation("DiveSlide")
		humanoid.JumpPower = Settings.BaseJumpPower
		humanoid.MaxSlopeAngle = 60
	end)
end

local function LongJump_Ability()
	pcall(function()
		if AbilityVars.Emoting then return end
		local char = AbilityVars.char
		local humanoid = char and char:FindFirstChild("Humanoid")
		local rootpart = char and char:FindFirstChild("HumanoidRootPart")
		if not humanoid or not rootpart then return end

		AbilityVars.Crouching = false
		AbilityVars.LongJumping = true

		local running = rootpart:FindFirstChild("Running")
		if running then running.Volume = 0 end

		humanoid.Jump = true
		humanoid:ChangeState(Enum.HumanoidStateType.Flying)
		humanoid.WalkSpeed = Settings.LongJumpWalkSpeed
		rootpart.RotVelocity = Vector3.zero
		if AbilityVars.Trail then AbilityVars.Trail.Enabled = true end

		rootpart.Velocity = rootpart.CFrame:VectorToWorldSpace(Vector3.new(0, Settings.LongJumpUpForce, -humanoid.WalkSpeed * Settings.LongJumpForwardMultiplier))

		Sounds.PlaySound(char, JUMP_SOUND, 3, 1.5)
		AbilityVars.cananimate = false

		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end
		AbilityAnims:PlayAnimation("Longjump")
	end)
end

