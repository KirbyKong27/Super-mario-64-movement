local function stopParkourTracks()
	local h = Cur.hum
	if not h then return end
	for _, t in ipairs(h:GetPlayingAnimationTracks()) do
		if t ~= EmoteState.ca then
			pcall(function() t:Stop(0.15) end)
		end
	end
end

local function clearEmote()
	if EmoteState.ca then pcall(function() EmoteState.ca:Stop(0.25) end) end
	EmoteState.ca = nil
	if EmoteState.thread then task.cancel(EmoteState.thread) EmoteState.thread = nil end
	if EmoteState.timer then task.cancel(EmoteState.timer) EmoteState.timer = nil end
	EmoteState.variation = nil
	AbilityVars.Emoting = false
	AbilityVars.MovingEmote = false
	AbilityVars.cananimate = true
	if stopE then stopE.Visible = false end
	if Cur.hum then Cur.hum.WalkSpeed = Settings.BaseWalkSpeed end
end

local function playEmote(entry)
	local a, h = Cur.animator, Cur.hum
	if not a or not h then return end
	clearEmote()
	stopIdleVariant()
	stopParkourTracks()

	local id, vars, interval, speed, mode = entry[2], entry[3], entry[4], entry[5], entry[6] or "still"
	local emoteId = id
	if vars and #vars > 0 then emoteId = vars[math.random(1, #vars)] end

	AbilityVars.Emoting = true
	AbilityVars.cananimate = false

	local t = loadAnim(a, emoteId)
	t.Looped = true
	t.Priority = Enum.AnimationPriority.Action3
	EmoteState.ca = t

	if mode == "car" then
		AbilityVars.MovingEmote = true
		h.WalkSpeed = 8
		EmoteState.variation = emoteId
		EmoteState.timer = task.spawn(function()
			while EmoteState.ca and EmoteState.ca.IsPlaying and vars do
				task.wait(interval or 4)
				local cur = EmoteState.ca
				if not cur or not cur.IsPlaying then break end
				local newId = vars[math.random(1, #vars)]
				if newId ~= EmoteState.variation then
					local nt = loadAnim(a, newId)
					nt.Looped = true
					nt.Priority = Enum.AnimationPriority.Action3
					nt:Play(0.25)
					cur:Stop(0.25)
					EmoteState.ca = nt
					EmoteState.variation = newId
				end
			end
		end)
	elseif mode == "slow" then
		AbilityVars.MovingEmote = true
		h.WalkSpeed = 2.5
	elseif mode == "bhop" then
		AbilityVars.MovingEmote = true
		h.WalkSpeed = 17
	else
		h.WalkSpeed = 0
	end

	t:Play(0.25)
	if speed then t:AdjustSpeed(speed) end
	stopE.Visible = true

	EmoteState.thread = task.spawn(function()
		while EmoteState.ca and EmoteState.ca.IsPlaying do
			stopParkourTracks()
			task.wait(0.1)
		end
	end)
end

