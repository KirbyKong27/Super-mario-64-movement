	local function buildSlider(parent, field)
		local row = ins("Frame")
		row.Size = ud2(1, 0, 0, 46)
		row.BackgroundTransparency = 1
		row.Parent = parent

		local label = ins("TextLabel")
		label.Size = ud2(1, 0, 0, 18)
