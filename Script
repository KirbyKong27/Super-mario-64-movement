		label.TextColor3 = c3(220, 220, 220)
		label.Font = Enum.Font.Gotham
		label.TextSize = 13
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = row

		local bar = ins("Frame")
		bar.Size = ud2(1, 0, 0, 18)
		bar.Position = ud2(0, 0, 0, 24)
		bar.BackgroundColor3 = c3(40, 40, 40)
		bar.Parent = row
		corner(bar, 4)

		local fill = ins("Frame")
		fill.BackgroundColor3 = c3(0, 150, 255)
		fill.BorderSizePixel = 0
		fill.Parent = bar
		corner(fill, 4)

		local knob = ins("TextButton")
		knob.Size = ud2(0, 14, 0, 26)
		knob.AnchorPoint = v2(0.5, 0.5)
		knob.BackgroundColor3 = c3(255, 255, 255)
		knob.Text = ""
		knob.Parent = bar
		corner(knob, 3)

		local function render()
			local v = Settings[field.key]
			local frac = math.clamp((v - field.min) / (field.max - field.min), 0, 1)
			fill.Size = ud2(frac, 0, 1, 0)
			knob.Position = ud2(frac, 0, 0.5, 0)
			label.Text = field.label .. ": " .. fmt(v)
		end

		local function setFromFraction(frac)
			frac = math.clamp(frac, 0, 1)
			local raw = field.min + (field.max - field.min) * frac
			local stepped = math.clamp(math.floor((raw / field.step) + 0.5) * field.step, field.min, field.max)
			Settings[field.key] = stepped
			render()
		end

		render()
		settingsRefreshers[field.key] = render

		local dragging = false
		knob.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
		end)
		gconn(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
		end))
		gconn(UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				if bar.AbsoluteSize.X > 0 then
					setFromFraction((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
				end
			end
		end))
		bar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				if bar.AbsoluteSize.X > 0 then
					setFromFraction((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
				end
			end
		end)
	end

