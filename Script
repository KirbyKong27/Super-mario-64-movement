local Effects = {}
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, 0, false, 0)

local function createDustPart()
	local dust = ins("Part")
	dust.Name = "Dust"
	dust.Shape = Enum.PartType.Ball
	dust.Size = Vector3.new(0.69, 0.69, 0.69)
	dust.Color = Color3.new(1, 1, 1)
	dust.CanCollide = false
	dust.TopSurface = Enum.SurfaceType.Smooth
	dust.BottomSurface = Enum.SurfaceType.Smooth
	dust.Transparency = 0
	dust.Material = Enum.Material.Neon
	return dust
end

local function fadeAndDestroy(part)
	local tw = TweenService:Create(part, tweenInfo, {Size = Vector3.new(0, 0, 0), Transparency = 1})
	tw:Play()
	tw.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then pcall(function() part:Destroy() end) end
	end)
end

function Effects.Dust()
	local char = AbilityVars.char
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local d = createDustPart()
	d.Parent = char:FindFirstChild("GFX") or char
	d.CFrame = char.HumanoidRootPart.CFrame - Vector3.new(0, 2.8, 0)
	fadeAndDestroy(d)
end

function Effects.WalljumpDust()
	local char = AbilityVars.char
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart
	local d = createDustPart()
	d.Parent = char:FindFirstChild("GFX") or char
	local _, point = workspace:FindPartOnRay(Ray.new(root.Position, root.CFrame.LookVector * -1.5), char)
	if point then d.Position = point else d.CFrame = root.CFrame end
	fadeAndDestroy(d)
end

function Effects.LandEffect(_, radius, number)
	local char = AbilityVars.char
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	local root = char.HumanoidRootPart
	local gfx = char:FindFirstChild("GFX") or char
	for i = 1, number do
		local angle = (math.pi * 2) / number * i
		local p = createDustPart()
		p.Parent = gfx
		p.Anchored = true
		p.Position = Vector3.new(root.Position.X + math.cos(angle) * radius, root.Position.Y - 2.5, root.Position.Z + math.sin(angle) * radius)
		fadeAndDestroy(p)
	end
end

