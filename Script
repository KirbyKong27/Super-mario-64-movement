		AbilityVars.hitfloor = false
		AbilityVars.Crouching = false

		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do track:Stop() end

		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		AbilityAnims:PlayAnimation("GroundPoundS")
		Sounds.PlaySound(char, JUMP_SOUND, 3, 1.5)

		local vel = ins("BodyVelocity", rootpart)
		vel.Velocity = Vector3.zero
		vel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		vel.Name = "GroundPoundVelocity"

		task.wait(Settings.GroundPoundChargeTime)
		if AbilityVars.Gen ~= gen then vel:Destroy() return end

		if AbilityVars.Trail then AbilityVars.Trail.Enabled = true end
		vel.Velocity = rootpart.CFrame.UpVector * Settings.GroundPoundSlamSpeed
		AbilityAnims:StopAnimation("GroundPoundS")
		AbilityAnims:PlayAnimation("GroundPound")

		repeat task.wait() until AbilityVars.hitfloor or AbilityVars.Gen ~= gen

		if AbilityVars.Trail then AbilityVars.Trail.Enabled = false end
		AbilityVars.canGroundPound = true
		AbilityAnims:StopAnimation("GroundPound")
		vel:Destroy()
		AbilityVars.hitfloor = false
		AbilityVars.GroundPounding = false
		AbilityVars.cananimate = true

		local hitfloorGP = char:FindFirstChild("HitfloorGP")
		if hitfloorGP then hitfloorGP.Value = true end
		task.wait(Settings.GroundPoundRecoveryTime)
		if hitfloorGP then hitfloorGP.Value = false end
	end)
end

